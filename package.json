{
  "name": "asn1",
  "type": "module",
  "displayName": "ASN.1",
  "description": "ASN.1 syntax, snippets, formatting, and more.",
  "version": "1.2.0",
  "engines": {
    "vscode": "^1.118.0"
  },
  "publisher": "wildboar",
  "categories": [
    "Formatters",
    "Programming Languages",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "icon": "images/Icon512.png",
  "homepage": "https://github.com/JonathanWilbur/vscode-asn1/README.md",
  "contributes": {
    "configurationDefaults": {
      "[asn1]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        }
      }
    },
    "configuration": {
      "title": "ASN.1 Language",
      "properties": {
        "asn1.includeFiles": {
          "type": "string",
          "default": "**/*.{asn,asn1}",
          "description": "Glob matching ASN.1 files in this workspace."
        },
        "asn1.excludeFiles": {
          "type": "string",
          "default": "**/{node_modules,dist,out,build,.git}/**",
          "description": "Glob matching ASN.1 files in this workspace."
        },
        "asn1.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable diagnostics for ASN.1 files."
        },
        "asn1.strictModuleOidMatch": {
          "type": "boolean",
          "default": true,
          "description": "Match modules strictly, by OID, respecting WITH SUCCESSORS and WITH DESCENDANTS. If false, modules are only matched by name."
        },
        "asn1.maxLineLength": {
          "type": "number",
          "minimum": 1,
          "description": "Maximum preferred line length, used in formatting"
        },
        "asn1.exportEndOfLine": {
          "type": "string",
          "enum": [
            "lf",
            "crlf"
          ],
          "description": "Line endings for CSV exports. Defaults to the line endings of the source ASN.1 file."
        },
        "asn1.alwaysDefined": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Identifiers to always treat as defined (for example ENUMERATED variants used without import)."
        }
      }
    },
    "commands": [
      {
        "command": "asn1.diagnose",
        "title": "Refresh ASN.1 Diagnostics"
      },
      {
        "command": "asn1.oid-to-csv.opendoc",
        "title": "Export All Object Identifiers in Current File to CSV"
      },
      {
        "command": "asn1.oid-to-csv.workspace",
        "title": "Export All Object Identifiers in Entire Workspace to CSV"
      },
      {
        "command": "asn1.deps-to-csv.opendoc",
        "title": "Export All ASN.1 Imports and Exports in Current File to CSV"
      },
      {
        "command": "asn1.deps-to-csv.workspace",
        "title": "Export All ASN.1 Imports and Exports in Entire Workspace to CSV"
      },
      {
        "command": "asn1.mods-to-csv.opendoc",
        "title": "Export All ASN.1 Modules in Current File to CSV"
      },
      {
        "command": "asn1.mods-to-csv.workspace",
        "title": "Export All ASN.1 Modules in Entire Workspace to CSV"
      },
      {
        "command": "asn1.assns-to-csv.opendoc",
        "title": "Export All ASN.1 Assignments in Current File to CSV"
      },
      {
        "command": "asn1.assns-to-csv.workspace",
        "title": "Export All ASN.1 Assignments in Entire Workspace to CSV"
      },
      {
        "command": "asn1.mods-to-json.opendoc",
        "title": "Export All ASN.1 Modules in Current File to JSON"
      },
      {
        "command": "asn1.reindex-implicit-symbols",
        "title": "Re-index ASN.1 Named Bits, Integers, and Enumerated Variants"
      }
    ],
    "languages": [
      {
        "id": "asn1",
        "aliases": [
          "ASN.1",
          "ASN",
          "asn"
        ],
        "extensions": [
          ".asn1",
          ".asn"
        ],
        "configuration": "./config/asn1.language-config.json"
      }
    ],
    "grammars": [
      {
        "language": "asn1",
        "scopeName": "source.asn1",
        "path": "./config/asn1.tmLanguage.json"
      },
      {
        "scopeName": "markdown.asn1.codeblock",
        "path": "./config/asn1.codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.asn": "asn1"
        }
      }
    ],
    "snippets": [
      {
        "language": "asn1",
        "path": "./config/asn1.code-snippets"
      }
    ],
    "languageModelTools": [
      {
        "name": "asn1_get_imports",
        "tags": [
          "import",
          "symbols",
          "dependencies"
        ],
        "toolReferenceName": "getImports",
        "displayName": "Get Imported Modules and Symbols",
        "modelDescription": "Get a JSON manifest of the modules and symbols imported in ASN.1 modules",
        "canBeReferencedInPrompt": true,
        "icon": "$(references)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "description": "The scope (files, globs, exclusions, modules, etc.) in which to search",
              "properties": {
                "uris": {
                  "type": "array",
                  "description": "URIs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "includeGlobs": {
                  "type": "array",
                  "description": "Globs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "excludeGlob": {
                  "type": "array",
                  "description": "Globs of files to exclude",
                  "items": {
                    "type": "string"
                  }
                },
                "moduleName": {
                  "type": "string",
                  "description": "If set, filter out all modules that don't match this name"
                },
                "moduleOid": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                },
                "selectionOption": {
                  "type": "string",
                  "description": "Module selection option",
                  "enum": [
                    "successors",
                    "descendants"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "name": "asn1_get_exported_symbols",
        "tags": [
          "import",
          "symbols",
          "dependencies"
        ],
        "toolReferenceName": "getExportedSymbols",
        "displayName": "Get Exported Symbols",
        "modelDescription": "Get a JSON manifest of the symbols exported in ASN.1 modules",
        "canBeReferencedInPrompt": true,
        "icon": "$(references)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "description": "The scope (files, globs, exclusions, modules, etc.) in which to search",
              "properties": {
                "uris": {
                  "type": "array",
                  "description": "URIs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "includeGlobs": {
                  "type": "array",
                  "description": "Globs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "excludeGlob": {
                  "type": "array",
                  "description": "Globs of files to exclude",
                  "items": {
                    "type": "string"
                  }
                },
                "moduleName": {
                  "type": "string",
                  "description": "If set, filter out all modules that don't match this name"
                },
                "moduleOid": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                },
                "selectionOption": {
                  "type": "string",
                  "description": "Module selection option",
                  "enum": [
                    "successors",
                    "descendants"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "name": "asn1_get_assignments",
        "tags": [
          "assignments",
          "definitions",
          "identifiers"
        ],
        "toolReferenceName": "getAssignments",
        "displayName": "Get Assignments",
        "modelDescription": "Get a JSON manifest of the assignments defined in ASN.1 modules",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-unordered)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "description": "The scope (files, globs, exclusions, modules, etc.) in which to search",
              "properties": {
                "uris": {
                  "type": "array",
                  "description": "URIs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "includeGlobs": {
                  "type": "array",
                  "description": "Globs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "excludeGlob": {
                  "type": "array",
                  "description": "Globs of files to exclude",
                  "items": {
                    "type": "string"
                  }
                },
                "moduleName": {
                  "type": "string",
                  "description": "If set, filter out all modules that don't match this name"
                },
                "moduleOid": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                },
                "selectionOption": {
                  "type": "string",
                  "description": "Module selection option",
                  "enum": [
                    "successors",
                    "descendants"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "name": "asn1_get_modules",
        "tags": [
          "modules"
        ],
        "toolReferenceName": "getModules",
        "displayName": "Get Modules",
        "modelDescription": "Get a JSON manifest of ASN.1 modules found in ASN.1 files",
        "canBeReferencedInPrompt": true,
        "icon": "$(package)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "description": "The scope (files, globs, exclusions, modules, etc.) in which to search",
              "properties": {
                "uris": {
                  "type": "array",
                  "description": "URIs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "includeGlobs": {
                  "type": "array",
                  "description": "Globs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "excludeGlob": {
                  "type": "array",
                  "description": "Globs of files to exclude",
                  "items": {
                    "type": "string"
                  }
                },
                "moduleName": {
                  "type": "string",
                  "description": "If set, filter out all modules that don't match this name"
                },
                "moduleOid": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                },
                "selectionOption": {
                  "type": "string",
                  "description": "Module selection option",
                  "enum": [
                    "successors",
                    "descendants"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "name": "asn1_get_object_identifiers",
        "tags": [
          "identifiers",
          "oids"
        ],
        "toolReferenceName": "getObjectIdentifiers",
        "displayName": "Get Object Identifiers",
        "modelDescription": "Get a JSON manifest of object identifiers found in ASN.1 files",
        "canBeReferencedInPrompt": true,
        "icon": "$(tag)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "description": "The scope (files, globs, exclusions, modules, etc.) in which to search",
              "properties": {
                "uris": {
                  "type": "array",
                  "description": "URIs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "includeGlobs": {
                  "type": "array",
                  "description": "Globs of files to include",
                  "items": {
                    "type": "string"
                  }
                },
                "excludeGlob": {
                  "type": "array",
                  "description": "Globs of files to exclude",
                  "items": {
                    "type": "string"
                  }
                },
                "moduleName": {
                  "type": "string",
                  "description": "If set, filter out all modules that don't match this name"
                },
                "moduleOid": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                },
                "selectionOption": {
                  "type": "string",
                  "description": "Module selection option",
                  "enum": [
                    "successors",
                    "descendants"
                  ]
                }
              }
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.cjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.cjs --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@std/csv": "npm:@jsr/std__csv@^1.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanWilbur/vscode-asn1.git"
  },
  "bugs": {
    "url": "https://github.com/JonathanWilbur/vscode-asn1/issues",
    "email": "jonathan@wilbur.space"
  },
  "keywords": [
    "asn.1",
    "asn",
    "abstract",
    "ber",
    "der",
    "itu",
    "x509"
  ],
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "pricing": "Free",
  "dependencies": {
    "@wildboar/asn1": "npm:@jsr/wildboar__asn1@^11.3.0",
    "@wildboar/asn1-parser": "npm:@jsr/wildboar__asn1-parser@^2.7.1"
  }
}
